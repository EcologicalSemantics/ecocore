PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX IAO: <http://purl.obolibrary.org/obo/IAO_>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Flag ECOCORE classes that have no term editor (IAO:0000117) annotation.
# Deprecated terms are excluded; they do not require an editor annotation.

SELECT ?cls ?label WHERE {
    ?cls a owl:Class ;
         rdfs:label ?label .
    FILTER ( regex(str(?cls), "^http://purl.obolibrary.org/obo/ECOCORE_") )
    FILTER NOT EXISTS { ?cls IAO:0000117 ?editor }
    FILTER NOT EXISTS { ?cls owl:deprecated "true"^^xsd:boolean }
    FILTER ( !isBlank(?cls) )
}
ORDER BY ?cls
