PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX IAO: <http://purl.obolibrary.org/obo/IAO_>

# Flag ECOCORE classes that have no rdfs:label.
# Imported terms and deprecated terms are excluded.

SELECT ?cls WHERE {
    ?cls a owl:Class .
    FILTER ( regex(str(?cls), "^http://purl.obolibrary.org/obo/ECOCORE_") )
    FILTER NOT EXISTS { ?cls rdfs:label ?label }
    FILTER NOT EXISTS { ?cls IAO:0100001 ?replacement }
    FILTER ( !isBlank(?cls) )
}
ORDER BY ?cls
