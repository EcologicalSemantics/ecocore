PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX IAO: <http://purl.obolibrary.org/obo/IAO_>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Flag ECOCORE classes that lack a textual definition (IAO:0000115).
# Imported terms are excluded; deprecated terms are excluded.

SELECT ?cls ?label WHERE {
    ?cls a owl:Class ;
         rdfs:label ?label .
    FILTER ( regex(str(?cls), "^http://purl.obolibrary.org/obo/ECOCORE_") )
    FILTER NOT EXISTS { ?cls IAO:0000115 ?def }
    FILTER NOT EXISTS { ?cls owl:deprecated "true"^^xsd:boolean }
    FILTER ( !isBlank(?cls) )
}
ORDER BY ?cls
