        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/ecocore/releases/2026-08-10/imports/po_import.owl"/>
        <dc:source rdf:resource="http://purl.obolibrary.org/obo/po/releases/2026-01-09/po.owl"/>
