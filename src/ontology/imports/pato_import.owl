    <!-- http://purl.obolibrary.org/obo/GO_0048856 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048856">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0032502"/>
