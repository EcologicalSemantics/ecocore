        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002009"/>
        <obo:IAO_0000115>A branchiness quality inhering in a bearer by virtue of the bearer&apos;s having branches.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ramified</oboInOwl:hasExactSynonym>
