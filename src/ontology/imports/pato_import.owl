    <!-- http://purl.obolibrary.org/obo/GO_0008544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009888"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the epidermis over time, from its formation to the mature structure. The epidermis is the outer epithelial layer of an animal, it may be a single layer that produces an extracellular material (e.g. the cuticle of arthropods) or a complex stratified squamous epithelium, as in the case of many vertebrate species.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>hypodermis development</oboInOwl:hasRelatedSynonym>
        <rdfs:label>epidermis development</rdfs:label>
    </owl:Class>
