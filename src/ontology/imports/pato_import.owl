    <!-- http://purl.obolibrary.org/obo/CL_0000056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000680"/>
        <obo:IAO_0000115>A cell that is commited to differentiating into a muscle cell.  Embryonic myoblasts develop from the mesoderm. They undergo proliferation, migrate to their various sites, and then differentiate into the appropriate form of myocytes.  Myoblasts also occur as transient populations of cells in muscles undergoing repair.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000222</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0650</oboInOwl:hasDbXref>
