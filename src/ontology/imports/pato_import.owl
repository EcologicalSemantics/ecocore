        <oboInOwl:hasExactSynonym>organ mucosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>region of mucosa</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mucosa</rdfs:label>
    </owl:Class>
