    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0002462"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A composition quality inhering in an bearer by virtue of the bearer&apos;s consisting of collagen.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:WD</oboInOwl:hasDbXref>
