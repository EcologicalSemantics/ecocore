    <!-- http://purl.obolibrary.org/obo/PATO_0000407 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002254"/>
        <obo:IAO_0000115>A quality inhering in a bearer by virtue of the bearer&apos;s having a horizontal surface without a slope, tilt, or curvature.</obo:IAO_0000115>
