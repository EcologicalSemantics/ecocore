    <!-- http://purl.obolibrary.org/obo/GO_0007113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0000278"/>
        <obo:IAO_0000115>A mitotic cell cycle in which chromosomes are replicated and sister chromatids separate, but spindle formation, nuclear membrane breakdown and nuclear division do not occur, resulting in an increased number of chromosomes in the cell.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Mitosis#Endomitosis</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>endomitosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>endomitotic cell cycle</rdfs:label>
    </owl:Class>
