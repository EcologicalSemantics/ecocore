        <oboInOwl:hasDbXref>VHOG:0001529</oboInOwl:hasDbXref>
        <rdfs:label>myoblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
