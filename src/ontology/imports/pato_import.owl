                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2759"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A membrane-bound cytoplasmic organelle of the endomembrane system that further processes the core oligosaccharides (e.g. N-glycans) added to proteins in the endoplasmic reticulum and packages them into membrane-bound vesicles. The Golgi apparatus operates at the intersection of the secretory, lysosomal, and endocytic pathways.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NIF_Subcellular:sao451912436</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Golgi_apparatus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Golgi complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Golgi ribbon</oboInOwl:hasNarrowSynonym>
        <rdfs:label>Golgi apparatus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005794"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A membrane-bound cytoplasmic organelle of the endomembrane system that further processes the core oligosaccharides (e.g. N-glycans) added to proteins in the endoplasmic reticulum and packages them into membrane-bound vesicles. The Golgi apparatus operates at the intersection of the secretory, lysosomal, and endocytic pathways.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0198506732</oboInOwl:hasDbXref>
    </owl:Axiom>
    


