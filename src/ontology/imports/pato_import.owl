        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002068"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Specialized cardiac myocyte that is subendocardially interspersed with the regular cardiac muscle cell. They are uninucleate cylindrical cells, associated end-to-end in long rows, continue from the node to the atrioventricular bundle; relatively short compared to ordinary myocytes but are nearly twice their diameter.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:0412046911</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:19939742</oboInOwl:hasDbXref>
