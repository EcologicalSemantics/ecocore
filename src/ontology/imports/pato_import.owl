    <!-- http://purl.obolibrary.org/obo/UBERON_0003909 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_2005260"/>
        <obo:IAO_0000115>Small blood vessel similar to a capillary but with a fenestrated endothelium. Sinusoids are found in the liver, lymphoid tissue, endocrine organs, and hematopoietic organs such as the bone marrow and the spleen. Sinusoids found within terminal villi of the placenta are not comparable to these; they possess a continuous endothelium and complete basal lamina[WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:63131</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:340163004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005261</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Sinusoid_(blood_vessel)</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005261</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sinusoidal blood vessel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sinusoidal blood vessel endothelium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>endothelium of irregular blood filled space</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sinusoidal capillary</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sinusoidal endothelium</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sinusoid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003909"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Small blood vessel similar to a capillary but with a fenestrated endothelium. Sinusoids are found in the liver, lymphoid tissue, endocrine organs, and hematopoietic organs such as the bone marrow and the spleen. Sinusoids found within terminal villi of the placenta are not comparable to these; they possess a continuous endothelium and complete basal lamina[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Sinusoid_(blood_vessel)</oboInOwl:hasDbXref>
    </owl:Axiom>
