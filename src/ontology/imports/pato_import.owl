    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000025"/>
        <obo:IAO_0000115>A composition quality inhering in an bearer by virtue of the bearer&apos;s consisting of collagen.</obo:IAO_0000115>
