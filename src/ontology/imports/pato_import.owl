        </rdfs:subClassOf>
        <obo:IAO_0000115>The thin bilaminar membrane derived from the prechordal plate that is devoid of mesoderm and formed by the apposition of the stomodeal ectoderm with the foregut endoderm; after the embryonic head fold has evolved it lies at the caudal limit of the stomodeum, forming a septum between the primitive mouth and pharynx; the membrane eventually disappears, and thus a communication is established between the mouth and the future pharynx.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EHDAA2:0000189</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:536</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16259</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:313607</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361412007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000380</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Buccopharyngeal_membrane</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>oral membrane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oral plate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oropharyngeal membrane</oboInOwl:hasRelatedSynonym>
        <rdfs:label>buccopharyngeal membrane</rdfs:label>
    </owl:Class>
