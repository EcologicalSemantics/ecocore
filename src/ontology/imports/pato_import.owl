            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cellular process in which two or more cells combine together, their plasma membrane fusing, producing a single cell. In some cases, nuclei fuse, producing a polyploid cell, while in other cases, nuclei remain separate, producing a syncytium.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cell cell fusion</oboInOwl:hasExactSynonym>
        <rdfs:label>cell-cell fusion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0140253"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cellular process in which two or more cells combine together, their plasma membrane fusing, producing a single cell. In some cases, nuclei fuse, producing a polyploid cell, while in other cases, nuclei remain separate, producing a syncytium.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Cell_fusion</oboInOwl:hasDbXref>
    </owl:Axiom>
    


