    <!-- http://purl.obolibrary.org/obo/GO_0032059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0032059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0120025"/>
        <obo:IAO_0000115>A cell extension caused by localized decoupling of the cytoskeleton from the plasma membrane and characterized by rapid formation, rounded shape, and scarcity of organelles within the protrusion. Blebs are formed during apoptosis and other cellular processes, including cell locomotion, cell division, and as a result of physical or chemical stresses.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Bleb_(cell_biology)</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>plasma membrane bleb</oboInOwl:hasExactSynonym>
        <rdfs:label>bleb</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0032059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cell extension caused by localized decoupling of the cytoskeleton from the plasma membrane and characterized by rapid formation, rounded shape, and scarcity of organelles within the protrusion. Blebs are formed during apoptosis and other cellular processes, including cell locomotion, cell division, and as a result of physical or chemical stresses.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mtg_apoptosis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12083798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:16624291</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Bleb_(cell_biology)</oboInOwl:hasDbXref>
