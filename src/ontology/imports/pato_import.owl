                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process resulting in the physical partitioning and separation of a myoblast into daughter cells. A myoblast is a mononucleate cell type that, by fusion with other myoblasts, gives rise to the myotubes that eventually develop into skeletal muscle fibers.</obo:IAO_0000115>
        <rdfs:label>myoblast division</rdfs:label>
    </owl:Class>
