        <owl:annotatedTarget>The lipid bilayer surrounding the vacuole and separating its contents from the cytoplasm of the cell.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ai</oboInOwl:hasDbXref>
    </owl:Axiom>
    


