    <!-- http://purl.obolibrary.org/obo/GO_0005577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0032991"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005615"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A highly soluble, elongated protein complex found in blood plasma and involved in clot formation. It is converted into fibrin monomer by the action of thrombin. In the mouse, fibrinogen is a hexamer, 46 nm long and 9 nm maximal diameter, containing two sets of nonidentical chains (alpha, beta, and gamma) linked together by disulfide bonds.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>fibrinogen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>fibrinogen alpha chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>fibrinogen beta chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>fibrinogen gamma chain</oboInOwl:hasNarrowSynonym>
        <rdfs:label>fibrinogen complex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005577"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A highly soluble, elongated protein complex found in blood plasma and involved in clot formation. It is converted into fibrin monomer by the action of thrombin. In the mouse, fibrinogen is a hexamer, 46 nm long and 9 nm maximal diameter, containing two sets of nonidentical chains (alpha, beta, and gamma) linked together by disulfide bonds.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0198547684</oboInOwl:hasDbXref>
    </owl:Axiom>
    


