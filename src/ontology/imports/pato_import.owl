            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The part of the aorta that extends from the origin at the heart to the diaphragm, and from which arises numerous branches that supply oxygenated blood to the chest cage and the organs within the chest.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000157</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0002525</oboInOwl:hasDbXref>
