        <oboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Fibroblast</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
