    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0009792 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009790"/>
        <rdfs:subClassOf>
