        <oboInOwl:hasRelatedSynonym>acyl groups</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>alkanoyl group</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>groupe acyle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acyl group</rdfs:label>
    </owl:Class>
