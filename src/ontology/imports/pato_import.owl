            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the organism over time, from the completion of embryonic development to the mature structure. See embryonic development.</obo:IAO_0000115>
        <rdfs:label>post-embryonic development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009791"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
