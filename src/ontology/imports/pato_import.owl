    <!-- http://purl.obolibrary.org/obo/UBERON_0001653 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003496"/>
