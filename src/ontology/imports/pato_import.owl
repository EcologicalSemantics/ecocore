        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0002266"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A shape that inheres in a 3 dimensional entity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:OREGON</oboInOwl:hasDbXref>
