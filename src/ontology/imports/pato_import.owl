            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A quality that inheres in a population of organisms.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">quality of a population</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000004">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
