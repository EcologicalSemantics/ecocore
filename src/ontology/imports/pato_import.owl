            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002494"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034878"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A horseshoe-shaped thickening of the endoderm at the cranial (rostral) end of the primitive streak formed by the involution of Spemann&apos;s organizer cells which, together with the notochord, induces the formation of the neural plate from the overlying ectodermal cells and contributes mesodermal type cells to the surrounding tissue.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>AAO:0011085</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA2:0001493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:181</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:295532</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000060</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000086</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Prechordal_plate</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000079</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000060</oboInOwl:hasDbXref>
        <rdfs:label>prechordal plate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003063"/>
