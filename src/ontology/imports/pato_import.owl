    <!-- http://purl.obolibrary.org/obo/GO_0043500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0043500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
