        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000963 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000957"/>
        <obo:IAO_0000115>A optical quality inhering in a bearer by virtue of the bearer&apos;s not being clear; not transmitting or reflecting light or radiant energy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>non-transparent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>clouding</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cloudy</oboInOwl:hasRelatedSynonym>
