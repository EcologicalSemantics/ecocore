    <!-- http://purl.obolibrary.org/obo/GO_0070483 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0070483">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0001666"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003032"/>
        <obo:IAO_0000115>The series of events in which a stimulus indicating lowered oxygen tension is received by a cell and converted into a molecular signal. Hypoxia, defined as a decline in O2 levels below normoxic levels of 20.8 - 20.95%, results in metabolic adaptation at both the cellular and organismal level.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>detection of reduced oxygen levels</oboInOwl:hasExactSynonym>
        <rdfs:label>detection of hypoxia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0070483"/>
