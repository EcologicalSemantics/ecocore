    <!-- http://purl.obolibrary.org/obo/GO_0009790 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009790">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0048856"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002296"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007275"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002296"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of an embryo from its formation until the end of its embryonic life stage. The end of the embryonic stage is organism-specific. For example, for mammals, the process would begin with zygote formation and end with birth. For insects, the process would begin at zygote formation and end with larval hatching. For plant zygotic embryos, this would be from zygote formation to the end of seed dormancy. For plant vegetative embryos, this would be from the initial determination of the cell or group of cells to form an embryo until the point when the embryo becomes independent of the parent plant.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Reactome:R-HSA-5619507</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Embryogenesis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonal development</oboInOwl:hasExactSynonym>
        <rdfs:label>embryo development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009790"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of an embryo from its formation until the end of its embryonic life stage. The end of the embryonic stage is organism-specific. For example, for mammals, the process would begin with zygote formation and end with birth. For insects, the process would begin at zygote formation and end with larval hatching. For plant zygotic embryos, this would be from zygote formation to the end of seed dormancy. For plant vegetative embryos, this would be from the initial determination of the cell or group of cells to form an embryo until the point when the embryo becomes independent of the parent plant.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:go_curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:isa_complete</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_sensu</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009790"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>Reactome:R-HSA-5619507</owl:annotatedTarget>
        <rdfs:label>Activation of HOX genes during differentiation</rdfs:label>
    </owl:Axiom>
    


