        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048749"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of the compound eye over time, from its formation to the mature structure. The compound eye is an organ of sight that contains multiple repeating units, often arranged hexagonally. Each unit has its own lens and photoreceptor cell(s) and can generate either a single pixelated image or multiple images, per eye.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:jid</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_sensu</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Eye</oboInOwl:hasDbXref>
    </owl:Axiom>
