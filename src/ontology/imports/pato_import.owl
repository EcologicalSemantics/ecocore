        <oboInOwl:hasExactSynonym>portion of mesenchymal tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>portion of mesenchyme tissue</oboInOwl:hasExactSynonym>
        <rdfs:label>mesenchyme</rdfs:label>
    </owl:Class>
