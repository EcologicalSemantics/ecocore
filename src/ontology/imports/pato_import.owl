        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005604"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A collagen heterotrimer containing type IV alpha chains; [alpha1(IV)]2alpha2(IV) trimers are commonly observed, although more type IV alpha chains exist and may be present in type IV trimers; type IV collagen triple helices associate to form 3 dimensional nets within basement membranes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Collagen_type_IV</oboInOwl:hasDbXref>
        <rdfs:label>collagen type IV trimer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
