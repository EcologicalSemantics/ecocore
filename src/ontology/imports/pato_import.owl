    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001873"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002078"/>
        <obo:IAO_0000115>A cylindrical shape that is hollow.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>tube like</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tube-shaped</oboInOwl:hasExactSynonym>
