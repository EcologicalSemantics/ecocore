    <!-- http://purl.obolibrary.org/obo/PATO_0002478 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001410"/>
        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer&apos;s being marked by narrow lines or grooves, usually parallel, that are oriented transversely relative to the long axis of the bearer.</obo:IAO_0000115>
