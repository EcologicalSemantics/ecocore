        <oboInOwl:hasRelatedSynonym>developing organism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>developmental tissue</oboInOwl:hasRelatedSynonym>
        <rdfs:label>embryo</rdfs:label>
    </owl:Class>
