    <!-- http://purl.obolibrary.org/obo/PATO_0002124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <obo:IAO_0000115>A quality inhering in a bearer by virtue of the bearer&apos;s processing the form of a thin plate sheet or layer.</obo:IAO_0000115>
        <rdfs:label>laminar</rdfs:label>
