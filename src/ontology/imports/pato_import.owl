        <oboInOwl:hasExactSynonym>brachiocephalic venous tree</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>innominate vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>innomiate vein</oboInOwl:hasRelatedSynonym>
