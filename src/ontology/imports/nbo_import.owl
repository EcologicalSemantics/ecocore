        <obo:IAO_0000115>Any substituent group which does not contain carbon.</obo:IAO_0000115>
        <rdfs:label>inorganic group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33247 -->

