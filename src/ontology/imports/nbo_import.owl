            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any substituent group or skeleton containing carbon.</obo:IAO_0000115>
        <rdfs:label>organic group</rdfs:label>
    </owl:Class>
    


