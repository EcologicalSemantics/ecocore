        <obo:IAO_0000115>A molecular entity having a net electric charge.</obo:IAO_0000115>
        <rdfs:label>ion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25212 -->

