        <obo:IAO_0000115>Any intermediate or product resulting from metabolism. The term &apos;metabolite&apos; subsumes the classes commonly known as primary and secondary metabolites.</obo:IAO_0000115>
        <rdfs:label>metabolite</rdfs:label>
    </owl:Class>
    


