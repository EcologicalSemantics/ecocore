    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33575 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35605"/>
