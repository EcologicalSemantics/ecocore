            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A defined linked collection of atoms or a single atom within a molecular entity.</obo:IAO_0000115>
        <rdfs:label>group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24651 -->

