        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51447"/>
        <obo:IAO_0000115>Any organic substituent group, regardless of functional type, having one free valence at a carbon atom.</obo:IAO_0000115>
        <rdfs:label>organyl group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33250 -->

