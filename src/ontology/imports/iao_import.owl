        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/ecocore/releases/2026-08-10/imports/iao_import.owl"/>
        <dc:source rdf:resource="http://purl.obolibrary.org/obo/iao/2026-03-30/iao.owl"/>
