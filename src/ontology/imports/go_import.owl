    <!-- http://purl.obolibrary.org/obo/GO_0006112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015980"/>
        <obo:IAO_0000115>The chemical reactions and pathways by which a cell derives energy from stored compounds such as fats or glycogen.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>energy reserve metabolism</oboInOwl:hasExactSynonym>
        <rdfs:label>energy reserve metabolic process</rdfs:label>
    </owl:Class>
