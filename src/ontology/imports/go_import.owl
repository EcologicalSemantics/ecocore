    <!-- http://purl.obolibrary.org/obo/GO_0019410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0019410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009060"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015975"/>
        <obo:IAO_0000115>The metabolic process in which carbon monoxide (CO) is oxidized to carbon dioxide (CO2) to generate energy. Conservation of energy in this process likely uses sodium ion gradients for ATP synthesis and is coupled to quantitative sulfide methylation.</obo:IAO_0000115>
        <rdfs:label>aerobic respiration, using carbon monoxide as electron donor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0019410"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The metabolic process in which carbon monoxide (CO) is oxidized to carbon dioxide (CO2) to generate energy. Conservation of energy in this process likely uses sodium ion gradients for ATP synthesis and is coupled to quantitative sulfide methylation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18024677</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0019412 -->

