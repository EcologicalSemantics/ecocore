        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>puberty</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dph</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
