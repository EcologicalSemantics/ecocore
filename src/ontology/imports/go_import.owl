    <!-- http://purl.obolibrary.org/obo/GO_0005982 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0044042"/>
        <obo:IAO_0000115>The chemical reactions and pathways involving starch, the most important reserve polysaccharide in plants. It is a glucan consisting of two components, amylose and amylopectin, which are both glucose homopolymers. Starch is synthesized as a temporary storage form of carbon and can be catabolized to produce sucrose.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>starch metabolism</oboInOwl:hasExactSynonym>
        <rdfs:label>starch metabolic process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005982"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The chemical reactions and pathways involving starch, the most important reserve polysaccharide in plants. It is a glucan consisting of two components, amylose and amylopectin, which are both glucose homopolymers. Starch is synthesized as a temporary storage form of carbon and can be catabolized to produce sucrose.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0198506732</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0006091 -->

