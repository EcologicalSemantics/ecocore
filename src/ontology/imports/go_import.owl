        <oboInOwl:hasDbXref>ISBN:0877795088</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0003006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0003006">
