        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003834"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005985"/>
        <rdfs:subClassOf>
            <owl:Restriction>
