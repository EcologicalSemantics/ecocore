        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009002"/>
        <obo:IAO_0000115>A plant cell (PO:0009002) that is either part of a multicellular whole plant (PO:0000003) &apos;in vivo&apos; or a unicellular organism &apos;in natura&apos; (i.e. part of a natural environment).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:586</oboInOwl:hasDbXref>
        <rdfs:label>native plant cell</rdfs:label>
