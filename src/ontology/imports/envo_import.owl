                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000062"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A vasculature that is part of a organ.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>organ vasculature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>set of blood vessels of organ</oboInOwl:hasExactSynonym>
        <rdfs:label>vasculature of organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006965 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014903"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The vascular cord is the primordial vasculature that will develop into blood vessels by the process of tubulogenesis[GO]. The vascular cord is composed of angioblast or vascular endothelial cells in a solid linear mass called a cord. The cord then undergoes tubulogenesis to form the lumen of the vessels[ZFA].</obo:IAO_0000115>
        <rdfs:label>vascular cord</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009881"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004872"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The splanchnic mesoderm in the cardiogenic region where the heart develops; it gives rise to endocardial heart tubes that fuse to form the primordial cardiac tube, the heart primordium[web]. Two migratory heart primordia that move ventrally during the course of neurulation, and then fuse[XAO].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cardiogenic splanchnopleure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cardiac mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cardiogenic mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cardiogenic region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>heart primordia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cardiogenic splanchnic mesoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
        <obo:IAO_0000115>Organism at the cleavage stage.</obo:IAO_0000115>
        <rdfs:label>cleaving embryo</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015228"/>
        <obo:IAO_0000115>A hollow, muscular organ, which, by contracting rhythmically, keeps up the circulation of the blood or analogs[GO,modified].</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>dorsal tube</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>heart</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>adult heart</oboInOwl:hasRelatedSynonym>
        <rdfs:label>primary circulatory organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006598"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009618"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A presumptive structure that has the potential to develop into a presomitic mesoderm.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>presumptive segmental plates</oboInOwl:hasRelatedSynonym>
        <rdfs:label>presumptive segmental plate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007285">
