                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004535"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasExactSynonym>heart/pericardium</oboInOwl:hasExactSynonym>
        <rdfs:label>heart plus pericardium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0016887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000481"/>
        <rdfs:subClassOf>
            <owl:Restriction>
