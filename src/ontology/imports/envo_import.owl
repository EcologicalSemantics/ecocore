                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002416"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organ component layer that is part of a integumental system.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>layer of skin</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>skin layer</oboInOwl:hasNarrowSynonym>
        <rdfs:label>integumentary system layer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0014477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010912"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000915"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Subdivision of skeletal system that consists of all skeletal elements in the thoracic region of the trunk. In most vertebrates this is the rib cage and sternum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>skeleton of thorax</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thoracic part of axial skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thoracic skeleton</oboInOwl:hasExactSynonym>
        <rdfs:label>thoracic skeleton</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0014903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001048"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
