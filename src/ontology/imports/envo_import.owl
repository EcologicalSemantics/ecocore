            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An interconnected tubular multi-tissue structure that contains fluid that is actively transported around the heart.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cardiac vasculature</oboInOwl:hasExactSynonym>
        <rdfs:label>heart vasculature</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0034921 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010000"/>
