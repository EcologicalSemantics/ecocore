        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A plant cell (PO:0009002) that is either part of a multicellular whole plant (PO:0000003) &apos;in vivo&apos; or a unicellular organism &apos;in natura&apos; (i.e. part of a natural environment).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Laurel_Cooper</oboInOwl:hasDbXref>
    </owl:Axiom>
    


