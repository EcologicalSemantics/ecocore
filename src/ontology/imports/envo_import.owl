            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A rigid covering that envelops an object.</obo:IAO_0000115>
        <rdfs:label>shell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006876 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006876">
