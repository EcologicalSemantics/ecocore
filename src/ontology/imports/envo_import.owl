        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000343"/>
        <obo:IAO_0000115>An altitudinal condition which inheres in a bearer by virtue of the bearer being located at an altitude between mid-altitude forests and the tree line.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>LTER:350</oboInOwl:hasDbXref>
        <rdfs:label>montane</rdfs:label>
    </owl:Class>
