    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000982"/>
        <obo:IAO_0000115>Joint in which the articulating bones or cartilages are connected by an articular capsule which encloses a synovial membrane and a synovial cavity. Examples: Temporomandibular joint, knee joint.[FMA].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>articulatio synoviale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diarthroses</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diarthrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diarthrosis joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>diarthrodial joints</oboInOwl:hasRelatedSynonym>
        <rdfs:label>synovial joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002329">
