            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The part of the conceptus that may be lost before birth or will be discarded at birth, or when the embryo becomes an independent organism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>extra-embryonic component</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>extraembryonic component</oboInOwl:hasExactSynonym>
        <rdfs:label>entire extraembryonic component</rdfs:label>
    </owl:Class>
    


