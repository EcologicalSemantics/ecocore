    <!-- http://purl.obolibrary.org/obo/ENVO_03000143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00010483"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001985"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An astronomical body part which is composed primarily of environmental materials in their frozen form.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">For the moment the definition links to liquid water but in the future we might need to link to other materials for other planets, e.g., Mars. Need to make this planet agnostic. Might want to not have the definition link to years as some astronomical body parts might not be in systems with years.

Note that in a strict sense, rocks are also frozen but in a practical sense we use terms like &quot;solidified&quot;. This maybe something to revist if we add more astrogelogical content.</obo:IAO_0000116>
        <oboInOwl:hasDbXref rdf:resource="http://sweetontology.net/realm/Cryosphere"/>
        <rdfs:label xml:lang="en">cryosphere</rdfs:label>
    </owl:Class>
