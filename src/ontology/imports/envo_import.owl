        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000143"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An astronomical body part which is composed primarily of environmental materials in their frozen form.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
    </owl:Axiom>
    


