    <!-- http://purl.obolibrary.org/obo/RO_0002295 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002295">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002324"/>
