        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009013"/>
        <obo:IAO_0000115>A portion of meristem tissue (PO:0009013) that is committed to the development of a root primordium (PO:0005029).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:427</oboInOwl:hasDbXref>
