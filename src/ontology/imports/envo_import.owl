    <!-- http://purl.obolibrary.org/obo/ENVO_00002982 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
