        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007688"/>
        <obo:IAO_0000115>An region of the mesoderm that includes anterior lateral mesoderm of the first heart field plus contiguous pharyngeal mesoderm that gives rise to second-heart-field-derived regions of the heart and branchiomeric muscles.</obo:IAO_0000115>
        <rdfs:label>cardiopharyngeal field</rdfs:label>
    </owl:Class>
    


