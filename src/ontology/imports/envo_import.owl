            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Presumptive structure of the blastula that will develop into mesoderm.</obo:IAO_0000115>
        <rdfs:label>presumptive mesoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006612 -->

