    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0018674">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0002049"/>
                    <owl:Restriction>
