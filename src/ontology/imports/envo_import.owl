                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000076"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Outermost layer of cells surrounding the embryo.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EVL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>enveloping layer</oboInOwl:hasExactSynonym>
        <rdfs:label>enveloping layer of ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003914"/>
        <obo:IAO_0000115>An epithelial tube open at both ends that allows fluid flow.</obo:IAO_0000115>
        <rdfs:label>epithelial tube open at both ends</rdfs:label>
    </owl:Class>
    


