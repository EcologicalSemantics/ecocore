    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PO_0025430 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009013"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000225"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of meristem tissue (PO:0009013) that is part of a peripheral zone (PO:0000225) of a shoot apical meristem (PO:0020148) and will give rise to a phyllome primordium (PO:0025128).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:427</oboInOwl:hasDbXref>
        <rdfs:label>phyllome anlagen</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025430"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A portion of meristem tissue (PO:0009013) that is part of a peripheral zone (PO:0000225) of a shoot apical meristem (PO:0020148) and will give rise to a phyllome primordium (PO:0025128).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Laurel_Cooper</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PO_0025433 -->

