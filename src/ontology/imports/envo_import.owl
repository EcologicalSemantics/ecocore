        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007503"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012275"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000926"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007798"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A blood island that is part of a mesoderm.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mesoderm blood islands</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mesenchyme blood island</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mesoderm blood island</rdfs:label>
    </owl:Class>
    


