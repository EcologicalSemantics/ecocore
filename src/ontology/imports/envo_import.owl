    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000467"/>
        <obo:IAO_0000115>Anatomical cluster consisting of the hematopoietic system and the lymphoid system, or its analogs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>hematolymphoid system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lymphomyeloid complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>haemolymphoid system</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hemolymphoid system</rdfs:label>
    </owl:Class>
    


