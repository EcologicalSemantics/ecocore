        <oboInOwl:hasExactSynonym>primitive heart tube</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>early primitive heart tube</oboInOwl:hasNarrowSynonym>
        <rdfs:label>primitive heart tube</rdfs:label>
    </owl:Class>
    


