            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A blood vessel that is part of a heart [Automatically generated definition].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>blood vessel of heart</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cardiac blood vessel</oboInOwl:hasRelatedSynonym>
        <rdfs:label>heart blood vessel</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0003513 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003513">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001981"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
