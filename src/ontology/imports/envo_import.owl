        <obo:IAO_0000116 xml:lang="en">Do not oversimplify this branch with design patterns or similar. The materials have properties that their components do not - write full definitions including these where possible.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">particulate environmental material</rdfs:label>
    </owl:Class>
    


