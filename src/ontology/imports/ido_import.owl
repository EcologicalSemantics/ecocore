    <!-- http://purl.obolibrary.org/obo/IDO_0000656 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IDO_0000656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000000"/>
        <obo:IAO_0000115>A pathogen transmission process in which a pathogen is transmitted from one host to another of the same Species, and the two hosts are not in a parent-child relationship.</obo:IAO_0000115>
        <obo:IAO_0000117>Lindsay Cowell</obo:IAO_0000117>
        <rdfs:label>horizontal pathogen transmission process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IDO_0000662 -->

