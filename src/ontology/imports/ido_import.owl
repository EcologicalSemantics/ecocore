        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115>A process which is necessary for the survival of an organism.</obo:IAO_0000115>
        <obo:IAO_0000117>Alex Diehl</obo:IAO_0000117>
        <obo:IAO_0000117>Lindsay Cowell</obo:IAO_0000117>
        <rdfs:label>life-sustaining process</rdfs:label>
    </owl:Class>
    


