        <obo:IAO_0000115>An infectious agent with an opportunistic infectious disposition.</obo:IAO_0000115>
        <obo:IAO_0000117>Albert Goldfain</obo:IAO_0000117>
        <obo:IAO_0000117>Alex Diehl</obo:IAO_0000117>
