            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A collection of Purkinje fibers that receives signals from the right and left bundle branches and innervates the ventricular cardiac muscle. The Purkinje fiber network creates synchronized contractions of the heart ventricles.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Purkinje fibre network</oboInOwl:hasExactSynonym>
        <rdfs:label>Purkinje fiber network</rdfs:label>
    </owl:Class>
