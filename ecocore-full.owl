    <!-- http://purl.obolibrary.org/obo/GO_0008219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009987"/>
        <obo:IAO_0000115>Any biological process that results in permanent cessation of all vital functions of a cell. A cell should be considered dead when any one of the following molecular or morphological criteria is met: (1) the cell has lost the integrity of its plasma membrane; (2) the cell, including its nucleus, has undergone complete fragmentation into discrete bodies (frequently referred to as apoptotic bodies). The cell corpse (or its fragments) may be engulfed by an adjacent cell in vivo, but engulfment of whole cells should not be considered a strict criteria to define cell death as, under some circumstances, live engulfed cells can be released from phagosomes (see PMID:18045538).</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>accidental cell death</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>necrosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cell death</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0008219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any biological process that results in permanent cessation of all vital functions of a cell. A cell should be considered dead when any one of the following molecular or morphological criteria is met: (1) the cell has lost the integrity of its plasma membrane; (2) the cell, including its nucleus, has undergone complete fragmentation into discrete bodies (frequently referred to as apoptotic bodies). The cell corpse (or its fragments) may be engulfed by an adjacent cell in vivo, but engulfment of whole cells should not be considered a strict criteria to define cell death as, under some circumstances, live engulfed cells can be released from phagosomes (see PMID:18045538).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mah</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_apoptosis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:25236395</oboInOwl:hasDbXref>
    </owl:Axiom>
    


