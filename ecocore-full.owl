        <oboInOwl:hasExactSynonym>appendage-girdle complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>appendage/girdle complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>girdle plus limb or fin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>limb</oboInOwl:hasRelatedSynonym>
