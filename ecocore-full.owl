    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0071941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008152"/>
        <obo:IAO_0000115>A nitrogen compound metabolic process that contributes to the nitrogen cycle. The nitrogen cycle is a series of metabolic pathways by which nitrogen is converted between various forms and redox states; it encompasses pathways in which nitrogen is acted upon directly, such as nitrification, denitrification, nitrogen fixation, and mineralization.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Nitrogen_cycle</oboInOwl:hasDbXref>
        <rdfs:label>nitrogen cycle metabolic process</rdfs:label>
