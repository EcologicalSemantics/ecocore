        <obo:IAO_0000115>The process in which the anatomical structures of venous blood vessels are generated and organized. Veins are blood vessels that transport blood from the body and its organs to the heart.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>venous morphogenesis</oboInOwl:hasExactSynonym>
        <rdfs:label>venous blood vessel morphogenesis</rdfs:label>
    </owl:Class>
