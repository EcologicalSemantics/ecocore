        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mass of solid material which is either 1) a minute fragment of a larger mass or 2) one of a collection of small masses composing an aggregate.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wiktionary.org/wiki/particle"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01003003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01003003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01003002"/>
