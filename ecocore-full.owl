    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005432"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The dilated structure that is lined by endothelial cells and located at the arterial pole of the heart just above (distal to) the truncus arteriosus in mammalian embryos; it is the primordial vascular channel from which the aortic arches (and eventually the dorsal aortae) arise; the aortic sac is homologous to the ventral aorta of gill-bearing vertebrates.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0012510</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005432"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>the merged ventral aortae of the embryo which supplies blood to the aortic arches[TMD][http://medical-dictionary.thefreedictionary.com/aortic+sac].</owl:annotatedTarget>
        <oboInOwl:source rdf:resource="http://medical-dictionary.thefreedictionary.com/aortic+sac"/>
    </owl:Axiom>
    <owl:Axiom>
