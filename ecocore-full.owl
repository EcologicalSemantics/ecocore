                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000228"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The formation of a syncytium, a mass of cytoplasm containing several nuclei enclosed within a single plasma membrane. Syncytia are normally derived from single cells that fuse or fail to complete cell division.</obo:IAO_0000115>
        <rdfs:label>syncytium formation</rdfs:label>
