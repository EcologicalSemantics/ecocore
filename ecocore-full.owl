                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>a heterotroph that consumes bacteria</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>bacterial feeder</oboInOwl:hasExactSynonym>
        <rdfs:label>bacterivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000020"/>
        <obo:IAO_0000115>A herbivorous process during which a living entity acquires food and energy by consuming grasses, leaves, and other soft plant material.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>herbivorous grazing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000100">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009010"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A heterotrophic process during which a living entity acquires food and energy by consuming seed.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>granivory</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>seed consumption</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">seed predation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000101 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000020"/>
        <obo:IAO_0000115>A herbivorous process during which a living entity acquires food and energy by consuming twigs, leaves, and bark of trees and shrubs.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>herbivorous browsing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000021"/>
        <obo:IAO_0000115>A carnivorous process during which a living entity acquires food and energy by consuming other animals while they are stil alive. Predation leads directly to the imminent death of the prey organism(s).</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:comment>The definition of predation can be controversial.</rdfs:comment>
        <rdfs:label>predation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000021"/>
        <obo:IAO_0000115>A carnivorous process during which a living entity acquires food and energy by consuming dead or decaying animal matter.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>necrophagy</oboInOwl:hasExactSynonym>
        <rdfs:label>scavenging</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000102"/>
        <obo:IAO_0000115>A predation process during which a living entity acquires food and energy by consuming all or part of another individual of the same species as food.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>cannibalism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000104"/>
        <obo:IAO_0000115>A cannibalistic process during which an embryo obtains food and energy by consuming a less-developed sibling while both are still in the uterus.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>intrauterine cannibalism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000105"/>
        <obo:IAO_0000115>An intrauterine cannibalistic process during which an embryo obtains food and energy by consuming a less-developed sibling embryo while both are still in the uterus.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>embryophagy</oboInOwl:hasExactSynonym>
        <rdfs:label>adelphophagy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000105"/>
        <obo:IAO_0000115>An intrauterine cannibalistic process during which an embryo obtains food and energy by consuming less-developed sibling eggs while both are still in the uterus.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>oophagy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000102"/>
        <obo:IAO_0000115>A predation process during which a living entity acquires food and energy by consuming insects.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>entomophagy</oboInOwl:hasExactSynonym>
        <rdfs:label>insectivory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000102"/>
        <obo:IAO_0000115>A predation process during which a living entity acquires food and energy by consuming eggs.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>egg predation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000102"/>
        <obo:IAO_0000115>A predation process during which a group of predators cooperates to kill creatures larger than those they could overpower singly.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Predation#Social_predation</obo:IAO_0000119>
        <rdfs:label>social predation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
        <obo:IAO_0000115>A heterotrophic process during which a living entity acquires food and energy by consuming a very narrow range of food items, sometimes only one.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>monophagy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
        <obo:IAO_0000115>A heterotrophic process during which a living entity acquires food and energy by consuming a few, very specific food items.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Oligophagy</obo:IAO_0000119>
        <rdfs:label>oligophagy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
        <obo:IAO_0000115>A heterotrophic process during which a living entity acquires food and energy by consuming a wide range of food items.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>polyphagy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000114">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A heterotrophic process during which a living entity acquires food and energy by consuming Bacteria.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>Bacteria consumption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>bacterial feeding</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">bactivory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000031"/>
        <obo:IAO_0000115>A reproductive quality inhering in a bearer by virtue of the bearer&apos;s ability to produce offspring via external fertilisation, the oocytes being scattered into the environment and fertilised outside the female&apos;s body by the male.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>broadcast spawn</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000031"/>
        <obo:IAO_0000115>A reproductive quality inhering in a bearer by virtue of the bearer&apos;s ability to produce offspring via external fertilisation, the oocytes being released in an ovigerous sac and fertilised outside the female&apos;s body by the male.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>sac spawn</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000120"/>
        <obo:IAO_0000115>a reproductive quality inhering in the bearer by virtue of the bearer having male reproductive organs at the beginning of its life and then switching to female reproductive organs</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>protandrous</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000120"/>
        <obo:IAO_0000115>a reproductive quality inhering in the bearer by virtue of the bearer having female reproductive organs at the beginning of its life and then switching to being a hermaphrodite</obo:IAO_0000115>
