        <obo:IAO_0000117>Chris Mungall</obo:IAO_0000117>
        <rdfs:label>involved in regulation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002429 -->

