        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000019"/>
        <obo:IAO_0000115>An herbivore that primarily consumes pollen</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q3805698</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pollen eater</oboInOwl:hasExactSynonym>
        <rdfs:label>palynivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
        <obo:IAO_0000115>A heterotrophic process during which a living entity acquires food and energy by eating food off of a surface while slowly moving through the environment.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>grazing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000019"/>
        <obo:IAO_0000115>An herbivore that primarily consumes nectar</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entry/Q120880</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nectar eater</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nectivore</oboInOwl:hasExactSynonym>
        <rdfs:label>nectarivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001995"/>
        <obo:IAO_0000115>An organismal quality inhering in a bearer by virtue of the bearer&apos;s ability to live in the top 20 cm of soil and make temporary, horizontal burrows.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <obo:IAO_0000117>https://orcid.org/0000-0002-1434-9495</obo:IAO_0000117>
        <rdfs:label>endogeic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000142">
        <obo:IAO_0000115>An organismal quality inhering in a bearer by virtue of the bearer&apos;s ability to burrow more than 20 cm deep into the soil and make permanent, vertical burrows.</obo:IAO_0000115>
        <obo:IAO_0000116>Deprecated: term moved to PATO or OBA. See GitHub issue #137.</obo:IAO_0000116>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <obo:IAO_0000117>https://orcid.org/0000-0002-1434-9495</obo:IAO_0000117>
        <rdfs:comment>Deprecated: term moved to PATO or OBA. See GitHub issue #137.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete anecic</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000143">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009010"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An herbivore that primarily consumes seeds</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q1974986</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>seed eater</oboInOwl:hasExactSynonym>
        <rdfs:label>granivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000144">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002040"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An herbivore that primarily consumes wood</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q2072826</oboInOwl:hasDbXref>
        <rdfs:label>xylophage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000019"/>
        <obo:IAO_0000115>An herbivore that primarily consumes plant exudates - gums, saps, and resins</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <obo:IAO_0000119>J.G. Fleagle 1988 Primate Adaptations and Evolution. Academic Press. NY</obo:IAO_0000119>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q17020010</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>gumivore</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gummivore</oboInOwl:hasExactSynonym>
        <rdfs:label>gumnivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000146">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000147"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000045"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A symbiotroph that reduces the fitness, survival, or growth of its symbiont, often called a host</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q10253316</oboInOwl:hasDbXref>
        <rdfs:label>parasite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000047"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000060"/>
        <obo:IAO_0000115>A symbiotrophic process during which a living entity acquires food and energy from another living entity via a close association. The entity providing the food and energy is harmed by this process.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>trophic parasitism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0100026"/>
        <obo:IAO_0000115>An organism that is consumed in whole or in part by a predator</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>prey</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000148"/>
        <obo:IAO_0000115>Prey that is successfully captured and consumed at a higher frequency than other types of prey. The predator may be specially adapted for capturing or consuming its preferred prey or have special nutritional requirements that are only met by the preferred prey.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>preferred prey</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000148"/>
        <obo:IAO_0000115>Prey that is consumed only if the preferred prey are unavailable.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>alternative prey</oboInOwl:hasExactSynonym>
        <rdfs:label>alternate prey</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000146"/>
        <obo:IAO_0000115>A parasite that lives entirely within the body of its host</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q9300235</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>endoparasite</oboInOwl:hasExactSynonym>
        <rdfs:label>internal parasite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000146"/>
        <obo:IAO_0000115>A parasite that lives on the exterior surface of its host</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q7880449</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ectoparasite</oboInOwl:hasExactSynonym>
        <rdfs:label>external parasite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000146"/>
        <obo:IAO_0000115>A parasite that enters the body of the host, but remains partially outside</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>mesoparasite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000102"/>
        <obo:IAO_0000115>A predation process during which a living entity acquires food and energy by consuming snakes.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q2746753</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>snake eating</oboInOwl:hasExactSynonym>
        <rdfs:label>ophiophagy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000011"/>
        <obo:IAO_0000115>A heterotrophic process during which a living entity acquires food and energy from consuming hard organisms or hard parts of organisms. This can include plants, such as bamboo, animals with hard shells, such as corals, or the hard parts of organisms, such as bone. Durophagy requires special adaptions, such as blunt, strong teeth and a heavy jaw.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Durophagy</obo:IAO_0000119>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q5316712</oboInOwl:hasDbXref>
        <rdfs:label>durophagy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000089"/>
        <obo:IAO_0000115>A predator that primarily eats fish</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasDbXref>https://www.wikidata.org/entity/Q1420208</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fish eater</oboInOwl:hasExactSynonym>
        <rdfs:label>piscivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000051"/>
        <obo:IAO_0000115>A suspension feeder that acquires nutrition by consuming particles using a filtering apparatus.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>filter feeder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000158">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000063"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000051"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000063"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A suspension feeder that acquires nutrition by consuming planktonic organisms.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>planktivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000010"/>
        <obo:IAO_0000115>A heterotroph that obtains dissolved organic compounds by osmosis for nutrition. An osmotroph is not directly involved in breaking down organic material to create the organic compounds it uses.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>osmotroph</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000060"/>
        <obo:IAO_0000115>A symbiotrophic process in which a bacterium provides chemically-derived energy and nutrients, often via the oxidation of hydrogen sulfide, to a higher organism.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>chemosymbiosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000060"/>
        <obo:IAO_0000115>A symbiotrophic process in which a photosynthetic organism provides energy and nutrients to a heterotrophic organism.</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>photosymbiosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000008"/>
        <obo:IAO_0000115>A trophic process during which a living entity acquires reducing equivalents from organic chemicals for use in biosynthesis or energy conservation via aerobic or anaerobic respiration.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>organotrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000008"/>
        <obo:IAO_0000115>A trophic process during which a living entity generates food from abiotic sources or through consumption of living or dead material, and captures energy from preformed molecules.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>chemotrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000164">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000010"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000165"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000178"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000088"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000165"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002470"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000178"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A heterotrophic organism capable of hematophagy that acquires food and energy by consuming blood.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>blood consumer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>blood eater</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hematophage</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">sanguivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000165">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000178"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000178"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carnivorous process during which a living entity acquires food and energy from consuming blood.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>hematophagy</rdfs:label>
    </owl:Class>
    


