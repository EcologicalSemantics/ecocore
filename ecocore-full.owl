        <oboInOwl:hasRelatedSynonym>future neural epithelium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>future neural layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>presumptive retina</oboInOwl:hasRelatedSynonym>
