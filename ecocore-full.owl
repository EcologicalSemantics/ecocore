        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>arbuscular mycorrhizae formation</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Arbuscular_mycorrhiza</oboInOwl:hasDbXref>
    </owl:Axiom>
