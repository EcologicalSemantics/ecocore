                                        <swrl:propertyPredicate rdf:resource="http://purl.obolibrary.org/obo/RO_0002013"/>
                                        <swrl:argument1 rdf:resource="urn:swrl#D"/>
                                        <swrl:argument2 rdf:resource="urn:swrl#C"/>
