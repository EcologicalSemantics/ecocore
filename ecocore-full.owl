            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A material which is composed primarily of chemical elements and compounds with relatively low boiling points, equilibrium condensation temperatures below 1300 Kelvin, and which are part of the crust or atmosphere of a moon or planet.</obo:IAO_0000115>
        <obo:IAO_0000116>Add and axiomatise with moon and lunar crust</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>volatile</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">volatile astrogeological material</rdfs:label>
    </owl:Class>
