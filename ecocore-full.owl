    <!-- http://purl.obolibrary.org/obo/GO_0030141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0030141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0099503"/>
        <rdfs:subClassOf>
            <owl:Restriction>
