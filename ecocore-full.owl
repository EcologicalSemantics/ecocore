                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001546"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental material which is in a solid state.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">solid environmental material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000815">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00010483"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
