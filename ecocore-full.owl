        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C0506992</owl:annotatedTarget>
        <oboInOwl:source>ncithesaurus:Pseudostratified_Columnar_Ciliated_Epithelium</oboInOwl:source>
    </owl:Axiom>
