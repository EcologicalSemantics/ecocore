                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000549"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A nucleated, immature erythrocyte in which the nucleus occupies a relatively smaller part of the cell than in its precursor, the basophilic erythroblast. The cytoplasm is beginning to acquire hemoglobin and thus is no longer a purely basophilic, but takes on acidophilic aspects, which becomes progressively more marked as the cell matures. The chromatin of the nucleus is arranged in coarse, deeply staining clumps. This cell is CD71-positive and lacks hematopoeitic lineage markers.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:83506</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>intermediate erythroblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>intermediate normoblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polychromatic erythroblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polychromatic normoblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polychromatophilic normoblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rubricyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CL:0000550</oboInOwl:id>
        <rdfs:label>polychromatophilic erythroblast</rdfs:label>
    </owl:Class>
