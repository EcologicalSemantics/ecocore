    <!-- http://purl.obolibrary.org/obo/UBERON_0001533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004573"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
