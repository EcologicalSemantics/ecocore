            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BSPO_0000126"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000468"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
