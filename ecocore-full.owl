    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
