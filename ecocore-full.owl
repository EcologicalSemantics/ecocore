        <oboInOwl:hasNarrowSynonym>tracheobronchial tree segment</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>airway</oboInOwl:hasRelatedSynonym>
