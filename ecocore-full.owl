        <oboInOwl:hasDbXref>MA:0002861</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D017539</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33820</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:8361002</oboInOwl:hasDbXref>
