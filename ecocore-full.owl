    <!-- http://purl.obolibrary.org/obo/UBERON_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000167">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0000464"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002572"/>
