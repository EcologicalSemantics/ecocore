        <owl:annotatedTarget>plasma membrane bleb</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0032060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0032060">
        <owl:equivalentClass>
            <owl:Class>
