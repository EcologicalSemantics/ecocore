        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <obo:IAO_0000115>x vessel drains blood from y if and only if x is a vessel that drains blood directly or indirectly from an anatomical structure y.</obo:IAO_0000115>
        <rdfs:label>vessel drains blood from</rdfs:label>
    </owl:ObjectProperty>
    


