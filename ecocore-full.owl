        <obo:IAO_0000115>A gland that is part of a eye. The eye is a compound unit which depending on the species may consist of an eyeballs plus associated ducts and integumentary structures. Eye glands therefore include the various types of lacrimal gland, the various types of apocrine and sebaceous glands associated with the eyelid.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EMAPA:35334</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000267</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>eye-associated gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gland of eye</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0004859</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#organ_slim"/>
        <rdfs:comment>Examples: harderian gland, accessory lacrimal gland, gland of Moll, gland of Zeis, nictitating membrane glands</rdfs:comment>
        <rdfs:label>eye gland</rdfs:label>
    </owl:Class>
    <owl:Axiom>
