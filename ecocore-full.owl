        <oboInOwl:hasDbXref>EHDAA2:0000726</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:518</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16247</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00003125</oboInOwl:hasDbXref>
