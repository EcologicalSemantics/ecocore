    <!-- http://purl.obolibrary.org/obo/UBERON_0004874 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
