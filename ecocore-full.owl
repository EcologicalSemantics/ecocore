        <oboInOwl:hasDbXref>MAT:0000181</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000181</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33547</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000407</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0427245</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001156</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VSAO:0000156</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pectoral_girdle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003063</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000407</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>skeletal parts of pectoral girdle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skeleton of pectoral girdle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
