        <rdfs:label>sensory system</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/c/c0/Gray722.png</foaf:depicted_by>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Anatomical system that overlaps the nervous system and is responsible for receiving and processing sensory information.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Sensory_system"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Anatomical system that overlaps the nervous system and is responsible for receiving and processing sensory information.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Sensory_system</oboInOwl:hasDbXref>
