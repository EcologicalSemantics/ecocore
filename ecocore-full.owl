    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002470">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002437"/>
        <obo:IAO_0000115>A biotic interaction where one organism consumes a material entity through a type of mouth or other oral opening.</obo:IAO_0000115>
