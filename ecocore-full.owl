        <oboInOwl:hasDbXref>Wikipedia:Mesenchyme</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003046</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000393</oboInOwl:hasDbXref>
