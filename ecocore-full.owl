        <oboInOwl:source rdf:resource="http://bgee.unil.ch/"/>
        <oboInOwl:source>DOI:10.1073/pnas.97.9.4449 Shimeld SM and Holland PW. Vertebrate innovations. PNAS (2000)</oboInOwl:source>
    </owl:Axiom>
