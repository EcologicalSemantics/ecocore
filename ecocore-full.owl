    <!-- http://purl.obolibrary.org/obo/UBERON_0011899 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
