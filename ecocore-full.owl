    <!-- http://purl.obolibrary.org/obo/UBERON_0012054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0012054">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0002553"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002572"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003082"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002553"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002572"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003082"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cavity within a myotome.</obo:IAO_0000115>
        <obo:UBPROP_0000003>The central cavity within the mesoderm is the paired primary or embryonic coelom. Parts of the embryonic coelom often become enclosed in the mesoderm, forming a myocoel within the epimere, a nephrocoel within the mesomere, and simple coelom (body cavity) within the lateral plate mesoderm.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref>EMAPA:31134</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001283</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0012054</oboInOwl:id>
        <rdfs:label>myocoele</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
