        <rdfs:label xml:lang="en">precipitation process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000703"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000406"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A hydrological process in which irregular aggregates of snow fall to the surface of an astronomical body.</obo:IAO_0000115>
        <obo:IAO_0000116>This is currently bound to water-based snow on Earth, may need revisions for interplanetary applications</obo:IAO_0000116>
        <oboInOwl:hasDbXref rdf:resource="http://sweetontology.net/phenAtmoPrecipitation/Snowfall"/>
        <oboInOwl:hasExactSynonym>snow fall</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">snowfall</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000930 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001110"/>
        <obo:IAO_0000115>An ecosystem which bridges two or more adjoining ecosystems and through which organisms may move or propagate.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>animal corridor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>green corridor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>habitat corridor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>wildlife corridor</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ecological corridor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000930"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ecosystem which bridges two or more adjoining ecosystems and through which organisms may move or propagate.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.eionet.europa.eu/gemet/concept/10510</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.eionet.europa.eu/gemet/concept/3756</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000947 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001110"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An envirommental system which bridges two or more biomes and which includes ecological communities which blend these biomes&apos; phylogenetic and phenotypic compositions.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ecotone</rdfs:label>
    </owl:Class>
    <owl:Axiom>
