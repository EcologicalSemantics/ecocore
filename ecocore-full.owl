        <oboInOwl:hasDbXref>SCTID:298225002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1179187</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lamina_propria</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lamina propria mucosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lamina propria mucosae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>tunica propria</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000030</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>lamina propria</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/f/fb/GI_Organization.svg</foaf:depicted_by>
    </owl:Class>
