            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A heterotrophic organism that is capable of insectivory.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>entomophage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>insectivory organism</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">insectivore</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000089"/>
        <obo:IAO_0000115>A predator that eats primary consumers or herbivores</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>secondary consumer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000093 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000089"/>
        <obo:IAO_0000115>A predator that eats secondary consumers</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>tertiary consumer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000089"/>
        <obo:IAO_0000115>A predator that eats tertiary consumers</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>quaternary consumer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000089"/>
        <obo:IAO_0000115>a predator residing at the top of a food chain upon which no other creatures prey.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>top predator</oboInOwl:hasExactSynonym>
        <rdfs:label>apex predator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000089"/>
        <obo:IAO_0000115>a predator that captures or traps prey by stealth or strategy, rather than by speed or strength.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>ambush predator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000097 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000055"/>
        <obo:IAO_0000115>a detritivore that consumes leaf litter</obo:IAO_0000115>
        <obo:IAO_0000117>https://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <rdfs:label>litter transformer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECOCORE_00000098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECOCORE_00000098">
