        <obo:IAO_0000115>The vessels formed within the first pair of branchial arches in embryogenesis.</obo:IAO_0000115>
        <obo:UBPROP_0000008>Disappears early in development in tetrapods</obo:UBPROP_0000008>
        <obo:UBPROP_0000012>ZFA states that The paired aortic arch 1 arteries branch off of the ventral aorta, and empty into the right and left lateral dorsal aortas</obo:UBPROP_0000012>
        <oboInOwl:hasAlternativeId>UBERON:0004371</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref rdf:resource="http://www.snomedbrowser.com/Codes/Details/308774003"/>
