        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <obo:IAO_0000115>x vessel supplies blood to y if and only if x is a vessel that supplies blood directly or indirectly to an anatomical structure y.</obo:IAO_0000115>
        <rdfs:label>vessel supplies blood to</rdfs:label>
    </owl:ObjectProperty>
    


