        <oboInOwl:hasDbXref>ZFA:0000028</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cardiac field</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fused heart primordium</oboInOwl:hasRelatedSynonym>
