        <rdfs:label>serous membrane</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/4/4e/Ens.png</foaf:depicted_by>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/en/thumb/4/4e/Ens.png/200px-Ens.png</foaf:depicted_by>
    </owl:Class>
