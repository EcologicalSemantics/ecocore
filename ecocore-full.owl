                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002007"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005773"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The lipid bilayer surrounding the vacuole and separating its contents from the cytoplasm of the cell.</obo:IAO_0000115>
        <rdfs:label>vacuolar membrane</rdfs:label>
    </owl:Class>
    <owl:Axiom>
