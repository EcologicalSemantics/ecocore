        <oboInOwl:hasExactSynonym>4th pharyngeal arch mesenchyme</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>4th branchial arch mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pharyngeal arch 4 mesenchyme</oboInOwl:hasRelatedSynonym>
