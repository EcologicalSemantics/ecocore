        <oboInOwl:hasExactSynonym>lung epithelial tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>pulmonary epithelium</oboInOwl:hasRelatedSynonym>
