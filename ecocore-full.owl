    <!-- http://purl.obolibrary.org/obo/RO_0002082 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002082">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002081"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002223"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002229"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <obo:IAO_0000115>Relation between occurrents, shares start and end boundaries.</obo:IAO_0000115>
        <obo:IAO_0000115>x simultaneous with y iff ω(x) = ω(y) and ω(α ) = ω(α), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point and &apos;=&apos; indicates the same instance in time.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <obo:IAO_0000117>David Osumi-Sutherland</obo:IAO_0000117>
        <oboInOwl:hasDbXref>RO:0002082</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>coincides_with</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>is_equal_to</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>simultaneous_with</oboInOwl:id>
        <oboInOwl:shorthand>simultaneous_with</oboInOwl:shorthand>
        <rdfs:label xml:lang="en">simultaneous with</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0002082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Relation between occurrents, shares start and end boundaries.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:hasDbXref>Allen:is_equal_to</oboInOwl:hasDbXref>
    </owl:Axiom>
    


