                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050907"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell specialized to detect chemical substances and relay that information centrally in the nervous system. Chemoreceptors may monitor external stimuli, as in taste and olfaction, or internal stimuli, such as the concentrations of oxygen and carbon dioxide in the blood.</obo:IAO_0000115>
        <rdfs:label>chemoreceptor cell</rdfs:label>
    </owl:Class>
