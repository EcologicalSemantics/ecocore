    <!-- http://purl.obolibrary.org/obo/RO_0002431 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002431">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002264"/>
