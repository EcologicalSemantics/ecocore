        <obo:IAO_0000115>Any process that modulates the frequency, rate or extent of muscle contraction.</obo:IAO_0000115>
        <rdfs:label>regulation of muscle contraction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0006937"/>
