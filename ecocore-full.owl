    <!-- http://purl.obolibrary.org/obo/UBERON_0000992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000992">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
