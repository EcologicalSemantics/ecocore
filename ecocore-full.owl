                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0032059"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The assembly of a bleb, a cell extension caused by localized decoupling of the cytoskeleton from the plasma membrane and characterized by rapid formation, rounded shape, and scarcity of organelles within the protrusion. Plasma membrane blebbing occurs during apoptosis and other cellular processes, including cell locomotion, cell division, and as a result of physical or chemical stresses.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cell blebbing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plasma membrane bleb assembly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plasma membrane blebbing</oboInOwl:hasExactSynonym>
        <rdfs:label>bleb assembly</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0032060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The assembly of a bleb, a cell extension caused by localized decoupling of the cytoskeleton from the plasma membrane and characterized by rapid formation, rounded shape, and scarcity of organelles within the protrusion. Plasma membrane blebbing occurs during apoptosis and other cellular processes, including cell locomotion, cell division, and as a result of physical or chemical stresses.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mah</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_apoptosis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12083798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:16624291</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Bleb_(cell_biology)</oboInOwl:hasDbXref>
