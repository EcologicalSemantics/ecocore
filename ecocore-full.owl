    <!-- http://purl.obolibrary.org/obo/GO_0006935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042330"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042221"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The directed movement of a motile cell or organism, or the directed growth of a cell guided by a specific chemical concentration gradient. Movement may be towards a higher concentration (positive chemotaxis) or towards a lower concentration (negative chemotaxis).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Chemotaxis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>taxis in response to chemical stimulus</oboInOwl:hasExactSynonym>
        <rdfs:label>chemotaxis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0006935"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The directed movement of a motile cell or organism, or the directed growth of a cell guided by a specific chemical concentration gradient. Movement may be towards a higher concentration (positive chemotaxis) or towards a lower concentration (negative chemotaxis).</owl:annotatedTarget>
