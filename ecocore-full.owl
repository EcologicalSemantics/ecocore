                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000277"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A crystal which is primarily composed of water ice.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <rdfs:label xml:lang="en">water ice crystal</rdfs:label>
    </owl:Class>
    


