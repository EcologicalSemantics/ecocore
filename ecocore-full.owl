    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0003104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003104">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0000479"/>
