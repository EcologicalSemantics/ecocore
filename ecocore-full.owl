        <oboInOwl:hasExactSynonym>aqueous humor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>aqueous humour</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>humor aquosus</oboInOwl:hasExactSynonym>
