            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Irregular connective tissue is an irregular connective tissue, the intercellular matrix of which contains a dense irregular network of collagen and elastic fiber bundles. Examples: connective tissue of peritoneum, connective tissue of fibrous pericardium.</obo:IAO_0000115>
        <obo:UBPROP_0000001>Tissue characterized by a thick, random arrangement of collagen and elastin fibers with very few cells. The majority of the cells are fibroblasts, but mast cells and macrophages may also be seen. It is found in the dermis, periosteum, perichondrium, capsules of organs and sheaths of nerves and muscles[NCIT]</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Dense_irregular_connective_tissue"/>
        <oboInOwl:hasDbXref rdf:resource="http://linkedlifedata.com/resource/umls/id/C0738366"/>
        <oboInOwl:hasDbXref>FMA:20109</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32882</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0738366</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dense_irregular_connective_tissue</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>irregular dense connective tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>typus irregularis (textus connectivus collagenosus compactus)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0011822</oboInOwl:id>
        <rdfs:label>dense irregular connective tissue</rdfs:label>
    </owl:Class>
