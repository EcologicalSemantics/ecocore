    <!-- http://purl.obolibrary.org/obo/UBERON_0010364 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010912"/>
