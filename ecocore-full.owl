        <oboInOwl:hasRelatedSynonym>pectoral girdle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>scapular girdle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0007831</oboInOwl:id>
