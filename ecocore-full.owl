        <oboInOwl:hasExactSynonym>adipocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adipose cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fat cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CL:0000136</oboInOwl:id>
        <rdfs:label>adipocyte</rdfs:label>
        <rdfs:label>fat cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
