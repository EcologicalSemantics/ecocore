                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A stem cell that is part of the corneo-scleral limbus. This cell type resides at the basal layer of the epithelium and has a small size and high nuclear to cytoplasmatic ratio (Secker and Daniels, 2009). A limbal stem cell is responsible for corneal epithelial renewal and repair (Li et al., 2023), and to help maintain a clear corneal surface by preventing conjunctival epithelial cells from migrating onto the cornea (Wang et al., 2023).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>limbal epithelial stem cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>limbal stem cell</oboInOwl:hasExactSynonym>
        <rdfs:label>limbal epithelial stem cell of cornea</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4033093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A stem cell that is part of the corneo-scleral limbus. This cell type resides at the basal layer of the epithelium and has a small size and high nuclear to cytoplasmatic ratio (Secker and Daniels, 2009). A limbal stem cell is responsible for corneal epithelial renewal and repair (Li et al., 2023), and to help maintain a clear corneal surface by preventing conjunctival epithelial cells from migrating onto the cornea (Wang et al., 2023).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:20614614</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:29105366</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:36983561</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:37768272</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
