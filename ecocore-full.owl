        <oboInOwl:hasDbXref>XAO:0004121</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001702</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>apical epidermal ridge</oboInOwl:hasExactSynonym>
