        <oboInOwl:hasRelatedSynonym>dermoskeleton</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>desmoskeleton</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0010364</oboInOwl:id>
        <rdfs:comment>This ontology covers metazoa, so we do not use exoskeleton as primary label, as in VSAO</rdfs:comment>
        <rdfs:label>dermal skeleton</rdfs:label>
