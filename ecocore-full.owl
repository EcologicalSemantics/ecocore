    <!-- http://purl.obolibrary.org/obo/GO_0009790 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009790">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0048856"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002296"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007275"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002296"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of an embryo from its formation until the end of its embryonic life stage. The end of the embryonic stage is organism-specific. For example, for mammals, the process would begin with zygote formation and end with birth. For insects, the process would begin at zygote formation and end with larval hatching. For plant zygotic embryos, this would be from zygote formation to the end of seed dormancy. For plant vegetative embryos, this would be from the initial determination of the cell or group of cells to form an embryo until the point when the embryo becomes independent of the parent plant.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Reactome:R-HSA-5619507</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Embryogenesis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonal development</oboInOwl:hasExactSynonym>
        <rdfs:label>embryo development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009790"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of an embryo from its formation until the end of its embryonic life stage. The end of the embryonic stage is organism-specific. For example, for mammals, the process would begin with zygote formation and end with birth. For insects, the process would begin at zygote formation and end with larval hatching. For plant zygotic embryos, this would be from zygote formation to the end of seed dormancy. For plant vegetative embryos, this would be from the initial determination of the cell or group of cells to form an embryo until the point when the embryo becomes independent of the parent plant.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:go_curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:isa_complete</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_sensu</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009790"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>Reactome:R-HSA-5619507</owl:annotatedTarget>
        <rdfs:label>Activation of HOX genes during differentiation</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0009791 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0032501"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0007275"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the organism over time, from the completion of embryonic development to the mature structure. See embryonic development.</obo:IAO_0000115>
        <rdfs:label>post-embryonic development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009791"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of the organism over time, from the completion of embryonic development to the mature structure. See embryonic development.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009791"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of the organism over time, from the completion of embryonic development to the mature structure. See embryonic development.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:go_curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0009792 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009790"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of an embryo over time, from zygote formation until the end of the embryonic life stage. The end of the embryonic life stage is organism-specific and may be somewhat arbitrary; for mammals it is usually considered to be birth, for insects the hatching of the first instar larva from the eggshell.</obo:IAO_0000115>
        <rdfs:label>embryo development ending in birth or egg hatching</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009792"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of an embryo over time, from zygote formation until the end of the embryonic life stage. The end of the embryonic life stage is organism-specific and may be somewhat arbitrary; for mammals it is usually considered to be birth, for insects the hatching of the first instar larva from the eggshell.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:go_curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:isa_complete</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_sensu</oboInOwl:hasDbXref>
    </owl:Axiom>
    


