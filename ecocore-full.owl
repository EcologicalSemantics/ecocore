    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002028"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The most posterior of the three principal regions of the brain, forming the rhombencephalon and all or most of the metencephalon. Kimmel et al, 1995.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
