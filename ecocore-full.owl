        <owl:annotatedTarget>dermomyotomes</owl:annotatedTarget>
        <oboInOwl:hasDbXref>VHOG:0000676</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/uberon/core#PLURAL"/>
