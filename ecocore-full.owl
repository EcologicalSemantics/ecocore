        <oboInOwl:hasDbXref>MA:0001287</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280888007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Iris_muscle</oboInOwl:hasDbXref>
