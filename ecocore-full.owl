        <oboInOwl:hasExactSynonym>cephalic neural crest</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cranial NCC population</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>head NCC population</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>crista neuralis cranialis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>head crest</oboInOwl:hasRelatedSynonym>
