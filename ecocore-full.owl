        <oboInOwl:hasNarrowSynonym>activation of cell proliferation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>stimulation of cell proliferation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>positive regulation of cell proliferation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>positive regulation of cell population proliferation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
