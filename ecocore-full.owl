    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000763"/>
        <obo:IAO_0000115>A immature or mature cell in the lineage leading to and including erythrocytes.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CL:0002156</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>CALOHA:TS-0290</oboInOwl:hasDbXref>
