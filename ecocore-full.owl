        <oboInOwl:hasDbXref>galen:PericardialSpace</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cavity of pericardial sac</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pericardial space</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cavitas pericardiaca</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001074</oboInOwl:id>
