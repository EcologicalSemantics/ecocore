        <oboInOwl:hasExactSynonym>neural tube segment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuromere</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuromeres</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>neural metamere</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>neural segment</oboInOwl:hasRelatedSynonym>
