    <!-- http://purl.obolibrary.org/obo/UBERON_0005421 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005421">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0004356"/>
                    <owl:Restriction>
