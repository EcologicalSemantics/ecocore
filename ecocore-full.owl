        <oboInOwl:hasRelatedSynonym>epidermis epithelial layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>epidermis outer layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>epitrichium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>periderm</oboInOwl:hasRelatedSynonym>
