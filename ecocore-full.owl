    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001396"/>
        <obo:IAO_0000115>A cellular quality inhering in a bearer by virtue of the bearer&apos;s having one or more cilia as a part.</obo:IAO_0000115>
        <rdfs:label>ciliated</rdfs:label>
    </owl:Class>
    <owl:Axiom>
