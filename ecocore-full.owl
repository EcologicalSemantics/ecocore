        <oboInOwl:hasDbXref>FMA:24728</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:64</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HAO:0000316</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002473</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D005145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C13071</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OpenCyc:Mx4rvVi5GZwpEbGdrcN5Y29ycA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:302549007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0015450</oboInOwl:hasDbXref>
