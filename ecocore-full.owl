        <oboInOwl:source rdf:resource="http://bgee.unil.ch/"/>
        <oboInOwl:source>DOI:10.1046/j.1469-7580.2001.19910133.x Graham A. The development and evolution of the pharyngeal arches. J Anat (2001)</oboInOwl:source>
    </owl:Axiom>
