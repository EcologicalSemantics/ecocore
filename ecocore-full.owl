        <obo:IAO_0000115>A heterotrophic organism that is capable of predation.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-2908-3327</obo:IAO_0000117>
        <oboInOwl:hasExactSynonym>predation organism</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">predator</rdfs:label>
    </owl:Class>
    


