is_a: NBO:0000121 ! agonistic behavior

[Term]
id: NBO:0020098
name: courtship begging
def: "Behavior by one animals soliciting food provision by a potential mate." []
is_a: NBO:0000077 ! courtship behavior

[Term]
id: NBO:0020101
name: sexual cannibalism
def: "Consumption of one member of a mating pair, usually the male, usually after the mating." []
