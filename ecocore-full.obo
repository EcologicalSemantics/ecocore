synonym: "mesodermal cluster" BROAD [GO:0001756]
synonym: "somites" RELATED PLURAL []
synonym: "somitic mesoderm" RELATED []
synonym: "somitus" RELATED LATIN [http://en.wikipedia.org/wiki/Somite]
