property_value: UBPROP:0000001 "An ectodermal thickening at the end of the hindlimb bud in the developing embryo. [TFD][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0001066", ontology="VHOG", source="http://bgee.unil.ch/", source="http://medical-dictionary.thefreedictionary.com/apical+ectodermal+ridge"}
