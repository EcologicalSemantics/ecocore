synonym: "Netzhaut" RELATED [BTO:0001175]
synonym: "retina of camera-type eye" EXACT [GO:0060041]
synonym: "retinas" RELATED PLURAL [ZFA:0000152]
synonym: "tunica interna of eyeball" EXACT []
