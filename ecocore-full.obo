relationship: connected_to UBERON:0001533 {subset="human_reference_atlas"} ! subclavian artery
relationship: part_of RO:0002577 ! system
property_value: foaf:depicted_by "http://upload.wikimedia.org/wikipedia/commons/b/b3/Costocervical_trunk_with_branches.png" xsd:anyURI

