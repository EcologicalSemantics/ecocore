property_value: foaf:depicted_by "http://upload.wikimedia.org/wikipedia/commons/2/29/Circulatory_System_en.svg" xsd:anyURI
property_value: IAO:0000232 "the cardiovascular system and the lymphatic system are parts of the circulatory system" xsd:string
property_value: RO:0002161 NCBITaxon:147099 {source="http://en.wikipedia.org/wiki/Acoelomorpha"}
