[Term]
id: ENVO:01000947
name: ecotone
def: "An envirommental system which bridges two or more biomes and which includes ecological communities which blend these biomes' phylogenetic and phenotypic compositions." [https://en.wikipedia.org/wiki/Ecotone, https://github.com/EnvironmentOntology/envo/issues/501, https://www.merriam-webster.com/dictionary/ecotone, ISBN:978-0-03-058414-5]
is_a: ENVO:01001110 ! ecosystem
relationship: has_component ENVO:00000428 {minCardinality="2"} ! biome
relationship: has_component ENVO:00000428 ! biome

[Term]
id: ENVO:01000951
name: natural environment
def: "An environmental system in which minimal to no anthropisation has occurred and non-human agents are the primary determinants of the system's dynamics and composition." [https://en.wikipedia.org/wiki/Anthropization, https://en.wikipedia.org/wiki/Natural_environment]
