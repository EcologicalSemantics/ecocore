is_a: ECOCORE:00000023 ! autotroph
property_value: IAO:0000117 "http://orcid.org/0000-0002-2908-3327" xsd:string
property_value: IAO:0000117 "http://orcid.org/0000-0002-4366-3088" xsd:string

[Term]
id: ECOCORE:00000013
