[Term]
id: NBO:0020111
name: injure
def: "Behavior in which one animal causes bodily damage to another." []
synonym: "injuring" EXACT []
is_a: NBO:0000121 ! agonistic behavior

[Term]
id: NBO:0020112
name: agonistic buffering
def: "Carrying or manipulation of infants or equivalent items to reduce chances of aggression on carrier by other animals." []
is_a: NBO:0000121 ! agonistic behavior

[Term]
id: NBO:0020141
name: agonistic chase
def: "Chasing of one animal by another during an agonistic conflict." []
is_a: NBO:0000121 ! agonistic behavior

[Term]
id: NBO:0020145
name: agonistic alarm
def: "Alarm behavior triggered by agonistic actions or postures." []
is_a: NBO:0000121 ! agonistic behavior
